# Copy this file to .env and put your real OpenAI key in it. Never share .env or push it to GitHub.
OPENAI_API_KEY=sk-your-key-here
# Optional:
# OPENAI_MODEL=gpt-4o-mini
# Optional — only if you want Cohere Rerank (lesson 13) instead of the built-in GPT rerank:
# COHERE_API_KEY=
# Optional — vision model used for image descriptions + scanned-page OCR (default gpt-4o):
# OPENAI_VISION_MODEL=gpt-4o
# Optional cost caps per PDF: OCR_MAX_PAGES=30, IMAGE_MAX_DESCRIBE=15
